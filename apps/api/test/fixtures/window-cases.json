    { "name": "London spring-forward day: 09:00 BST", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "Europe/London" }, "at": "2026-03-29T08:00:00Z", "expect": true },
    { "name": "London day before: 08:59:59 GMT", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "Europe/London" }, "at": "2026-03-28T08:59:59Z", "expect": false },
    { "name": "London day before: 09:00 GMT", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "Europe/London" }, "at": "2026-03-28T09:00:00Z", "expect": true },
    { "name": "Kolkata Mon-Fri 09-18: Fri 17:59:59", "w": { "days": [1,2,3,4,5], "start": 540, "end": 1080, "tz": "Asia/Kolkata" }, "at": "2026-11-06T12:29:59Z", "expect": true },
    { "name": "Kolkata Mon-Fri 09-18: Fri 18:00", "w": { "days": [1,2,3,4,5], "start": 540, "end": 1080, "tz": "Asia/Kolkata" }, "at": "2026-11-06T12:30:00Z", "expect": false },
    { "name": "Kolkata Mon-Fri 09-18: Sat 09:00", "w": { "days": [1,2,3,4,5], "start": 540, "end": 1080, "tz": "Asia/Kolkata" }, "at": "2026-11-07T03:30:00Z", "expect": false },
    { "name": "Kolkata Mon-Fri 09-18: Mon 09:00", "w": { "days": [1,2,3,4,5], "start": 540, "end": 1080, "tz": "Asia/Kolkata" }, "at": "2026-11-09T03:30:00Z", "expect": true },
    { "name": "Kolkata Mon-Fri 09-18: Mon 08:59:59", "w": { "days": [1,2,3,4,5], "start": 540, "end": 1080, "tz": "Asia/Kolkata" }, "at": "2026-11-09T03:29:59Z", "expect": false },
    { "name": "Kolkata Mon-Fri all day: Sunday 23:00 UTC is Monday 04:30 local", "w": { "days": [1,2,3,4,5], "start": 0, "end": 1440, "tz": "Asia/Kolkata" }, "at": "2026-11-08T23:00:00Z", "expect": true },
    { "name": "Kolkata Mon-Fri all day: Fri 18:29:59 UTC is Fri 23:59:59 local", "w": { "days": [1,2,3,4,5], "start": 0, "end": 1440, "tz": "Asia/Kolkata" }, "at": "2026-11-06T18:29:59Z", "expect": true },
    { "name": "Kolkata Mon-Fri all day: Fri 18:30 UTC is Sat 00:00 local", "w": { "days": [1,2,3,4,5], "start": 0, "end": 1440, "tz": "Asia/Kolkata" }, "at": "2026-11-06T18:30:00Z", "expect": false },
    { "name": "UTC Saturday all day: 00:00", "w": { "days": [6], "start": 0, "end": 1440, "tz": "UTC" }, "at": "2026-11-07T00:00:00Z", "expect": true },
    { "name": "UTC Saturday all day: 23:59:59", "w": { "days": [6], "start": 0, "end": 1440, "tz": "UTC" }, "at": "2026-11-07T23:59:59Z", "expect": true },
    { "name": "UTC Saturday all day: Sunday 00:00", "w": { "days": [6], "start": 0, "end": 1440, "tz": "UTC" }, "at": "2026-11-08T00:00:00Z", "expect": false },
    { "name": "UTC Saturday all day: Friday 23:59:59", "w": { "days": [6], "start": 0, "end": 1440, "tz": "UTC" }, "at": "2026-11-06T23:59:59Z", "expect": false },
    { "name": "Auckland DST start (southern hemisphere): 08:00 NZDT", "w": { "days": [1,2,3,4,5,6,7], "start": 480, "end": 540, "tz": "Pacific/Auckland" }, "at": "2026-09-26T19:00:00Z", "expect": true },
    { "name": "Auckland DST start: 09:00 NZDT", "w": { "days": [1,2,3,4,5,6,7], "start": 480, "end": 540, "tz": "Pacific/Auckland" }, "at": "2026-09-26T20:00:00Z", "expect": false },
    { "name": "Auckland day before: 07:00 NZST", "w": { "days": [1,2,3,4,5,6,7], "start": 480, "end": 540, "tz": "Pacific/Auckland" }, "at": "2026-09-25T19:00:00Z", "expect": false },
    { "name": "Auckland day before: 08:00 NZST", "w": { "days": [1,2,3,4,5,6,7], "start": 480, "end": 540, "tz": "Pacific/Auckland" }, "at": "2026-09-25T20:00:00Z", "expect": true }
