{
  "_comment": "Time-window boundary and daylight-saving cases. Checked against BOTH locks: schedule.ts inWindow() (access-policy.unit.test.ts) and tv_in_window() in Postgres (access-policy-db.test.ts). start/end are local minutes since midnight, end exclusive; days are ISO (1 Mon .. 7 Sun) of the local date.",
  "cases": [
    { "name": "NY Sat before DST: 08:59:59 EST", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-03-07T13:59:59Z", "expect": false },
    { "name": "NY Sat before DST: 09:00 EST", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-03-07T14:00:00Z", "expect": true },
    { "name": "NY spring-forward day: 08:59:59 EDT", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-03-08T12:59:59Z", "expect": false },
    { "name": "NY spring-forward day: 09:00 EDT (an hour earlier in UTC)", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-03-08T13:00:00Z", "expect": true },
    { "name": "NY spring-forward day: 16:59:59 EDT", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-03-08T20:59:59Z", "expect": true },
    { "name": "NY spring-forward day: 17:00 EDT (end is exclusive)", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-03-08T21:00:00Z", "expect": false },
    { "name": "NY day before fall-back: 08:59:59 EDT", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-10-31T12:59:59Z", "expect": false },
    { "name": "NY day before fall-back: 09:00 EDT", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-10-31T13:00:00Z", "expect": true },
    { "name": "NY fall-back day: 08:59:59 EST", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-11-01T13:59:59Z", "expect": false },
    { "name": "NY fall-back day: 09:00 EST (an hour later in UTC)", "w": { "days": [1,2,3,4,5,6,7], "start": 540, "end": 1020, "tz": "America/New_York" }, "at": "2026-11-01T14:00:00Z", "expect": true },
    { "name": "NY 02:00-03:00 on spring-forward day: 01:59:59 EST", "w": { "days": [1,2,3,4,5,6,7], "start": 120, "end": 180, "tz": "America/New_York" }, "at": "2026-03-08T06:59:59Z", "expect": false },
    { "name": "NY 02:00-03:00 on spring-forward day: the next instant is 03:00 EDT, so the window never opens", "w": { "days": [1,2,3,4,5,6,7], "start": 120, "end": 180, "tz": "America/New_York" }, "at": "2026-03-08T07:00:00Z", "expect": false },
    { "name": "NY 02:00-03:00 the next day: 02:00 EDT", "w": { "days": [1,2,3,4,5,6,7], "start": 120, "end": 180, "tz": "America/New_York" }, "at": "2026-03-09T06:00:00Z", "expect": true },
    { "name": "NY 01:00-02:00 on fall-back day: first 01:30 (EDT)", "w": { "days": [1,2,3,4,5,6,7], "start": 60, "end": 120, "tz": "America/New_York" }, "at": "2026-11-01T05:30:00Z", "expect": true },
    { "name": "NY 01:00-02:00 on fall-back day: second 01:30 (EST)", "w": { "days": [1,2,3,4,5,6,7], "start": 60, "end": 120, "tz": "America/New_York" }, "at": "2026-11-01T06:30:00Z", "expect": true },
    { "name": "NY 01:00-02:00 on fall-back day: 02:00 EST", "w": { "days": [1,2,3,4,5,6,7], "start": 60, "end": 120, "tz": "America/New_York" }, "at": "2026-11-01T07:00:00Z", "expect": false },
    { "name": "NY 01:00-02:00 on fall-back day: 00:59:59 EDT", "w": { "days": [1,2,3,4,5,6,7], "start": 60, "end": 120, "tz": "America/New_York" }, "at": "2026-11-01T04:59:59Z", "expect": false },
