# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4100
# The browser origin. State-changing requests from any other Origin are refused.
PUBLIC_ORIGIN=http://localhost:3000
# Runtime connection: the low-privilege app role (owns nothing; RLS and audit triggers apply).
DATABASE_URL=postgresql://tv_dev_app:CHANGE_ME@127.0.0.1:5432/trustvault_dev
# Migration connection: the schema owner. Used only by `prisma migrate`.
DATABASE_OWNER_URL=postgresql://tv_dev_owner:CHANGE_ME@127.0.0.1:5432/trustvault_dev
SHADOW_DATABASE_URL=postgresql://tv_dev_owner:CHANGE_ME@127.0.0.1:5432/trustvault_shadow
TEST_DATABASE_URL=postgresql://tv_dev_app:CHANGE_ME@127.0.0.1:5432/trustvault_test
TEST_DATABASE_OWNER_URL=postgresql://tv_dev_owner:CHANGE_ME@127.0.0.1:5432/trustvault_test
# Redis user restricted (by ACL) to keys starting with REDIS_PREFIX.
REDIS_URL=redis://tvdev:CHANGE_ME@127.0.0.1:6379
REDIS_PREFIX=tvdev:
# Development/tests only: 32 random bytes, base64. Production uses keyd.
KEY_PROVIDER=local
LOCAL_MASTER_KEY=
# Risky actions need a second factor presented within this many minutes (step-up, THREATS.md S20).
STEP_UP_MINUTES=5
# The Android app's passkey origin(s), comma separated: android:apk-key-hash:<base64url SHA-256 of the signing cert> (S22).
PASSKEY_ANDROID_ORIGINS=
# View-only pages one person may open per 10 minutes, and the bulk-viewing alert thresholds (THREATS.md V7).
PAGE_VIEW_RATE_LIMIT=600
PAGE_VIEW_ALERT_PAGES=150
PAGE_VIEW_ALERT_DOCUMENTS=15
# Proxies whose X-Forwarded-For is believed (Express "trust proxy"): loopback = nginx on the same host (THREATS.md P6).
TRUSTED_PROXIES=loopback
# Signs the trusted-device cookie (32 random bytes, base64). Optional: without
# it a random key is made at startup and trusted devices are forgotten on a
# restart. Development derives one from LOCAL_MASTER_KEY.
# DEVICE_TRUST_KEY=
# Tests: a second checkout can share Redis with its own key prefix.
# TEST_REDIS_PREFIX=tvdev:test:
