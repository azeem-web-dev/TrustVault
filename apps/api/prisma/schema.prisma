// TrustVault schema.
//
// Prisma describes the tables. Anything Prisma cannot express — table
// privileges for the app role, row-level security, and the triggers that
// make the audit log append-only and hash-chained — lives in hand-written
// SQL at the end of each migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  VIEWER
  EXTERNAL
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  /// Created by an admin; the person has not yet accepted the emailed invitation.
  INVITED
}

enum LinkPurpose {
  RESET
  INVITE
  SIGNIN
}

/// Actions that need a second administrator's approval (THREATS.md S19).
enum ApprovalAction {
  MFA_RESET
  BREAK_GLASS
}

enum AuditOutcome {
  ALLOWED
  DENIED
  FAILED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// Always stored lower-case and trimmed.
  email             String     @unique
  displayName       String     @map("display_name")
  role              Role
  status            UserStatus @default(ACTIVE)
  passwordHash      String     @map("password_hash")
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  /// External accounts stop working at this time. Required for EXTERNAL.
  accessExpiresAt   DateTime?  @map("access_expires_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?    @map("created_by_id") @db.Uuid
  deactivatedAt     DateTime?  @map("deactivated_at") @db.Timestamptz(6)
  /// When the person first chose a password. Null for an invitation never accepted.
  activatedAt       DateTime?  @default(now()) @map("activated_at") @db.Timestamptz(6)
  /// Published demo accounts: cannot be deactivated, demoted, renamed or
  /// have their password changed through the API (THREATS.md I8).
  isProtected       Boolean    @default(false) @map("is_protected")
  /// TOTP secret, encrypted by the key provider. Null until enrolled.
  totpSecretEnc     Bytes?     @map("totp_secret_enc")
  totpEnabledAt     DateTime?  @map("totp_enabled_at") @db.Timestamptz(6)
  /// Last accepted 30-second step, so a code cannot be replayed.
  totpLastStep      BigInt?    @map("totp_last_step")
  /// Emailed one-time codes turned on as a second factor (THREATS.md S30).
  /// Never for ADMIN or demo accounts (check constraints).
  emailOtpEnabledAt DateTime?  @map("email_otp_enabled_at") @db.Timestamptz(6)

  sessions         Session[]
  ownedDocuments   Document[]        @relation("DocumentOwner")
  folders          Folder[]
  grants           Grant[]           @relation("GrantUser")
  grantsGiven      Grant[]           @relation("GrantGrantedBy")
  groupMemberships GroupMember[]
  groupGrantCoverage GrantGroupMember[]
  resetTokens      PasswordResetToken[] @relation("ResetTokenUser")
  versionsUploaded DocumentVersion[]
  breakGlass       BreakGlass[]
  passkeys         Passkey[]
  approvalsAsked    AdminApproval[] @relation("ApprovalRequester")
  approvalsGiven    AdminApproval[] @relation("ApprovalApprover")
  approvalsRefused  AdminApproval[] @relation("ApprovalRejecter")
  approvalsAboutMe  AdminApproval[] @relation("ApprovalTargetUser")
  offlineKeys      OfflineKey[]
  downloadApproverFor Grant[]          @relation("GrantDownloadApprover")
  downloadRequests    DownloadApproval[] @relation("DownloadRequester")
  downloadDecisions   DownloadApproval[] @relation("DownloadDecider")
  overridesReceived   AccessOverride[]   @relation("OverrideUser")
  overridesGiven      AccessOverride[]   @relation("OverrideCreatedBy")
  overridesEnded      AccessOverride[]   @relation("OverrideRevokedBy")
  rolePoliciesSet     RoleAccessPolicy[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash  Bytes    @unique @map("token_hash")
  /// Sent back by the browser in a header on every state-changing request.
  csrfToken  String   @map("csrf_token")
  /// "password" now; "mfa" once a second factor has been checked.
  authLevel  String   @default("password") @map("auth_level")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Absolute lifetime. Idle timeout is checked against lastSeenAt.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  ip         String?
  userAgent  String?  @map("user_agent")
  /// Set when the session is ended (logout, password or role change,
  /// deactivation...). A revoked session never works again; the row is kept
  /// until expiry so a later attempt with it is recorded (THREATS.md L10).
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  /// When the first request with this ended session was refused and recorded.
  rejectedAt    DateTime? @map("rejected_at") @db.Timestamptz(6)
  /// When a second factor was last presented in this session. Risky actions
  /// need it to be recent (step-up, THREATS.md S20).
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only, hash-chained. seq, occurred_at, prev_hash and hash are set
/// by a database trigger, not by the application, so the app cannot
/// backdate an event or forge its place in the chain.
model AuditEvent {
  /// Placeholder default; the trigger assigns the real value under a lock.
  seq        BigInt       @id @default(0)
  id         String       @unique @default(uuid()) @db.Uuid
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId    String?      @map("actor_id") @db.Uuid
  actorEmail String?      @map("actor_email")
  action     String
  outcome    AuditOutcome
  reason     String?
  targetType String?      @map("target_type")
  targetId   String?      @map("target_id")
  documentId String?      @map("document_id") @db.Uuid
  ip         String?
  userAgent  String?      @map("user_agent")
  requestId  String?      @map("request_id")
  details    Json?
  prevHash   Bytes        @unique @default(dbgenerated()) @map("prev_hash")
  hash       Bytes        @unique @default(dbgenerated())

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([documentId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Documents and permissions
// ---------------------------------------------------------------------------

enum DocumentStatus {
  ACTIVE
  DELETED
}

/// VIEW: see the document and its rendered pages, never the original file.
enum GrantLevel {
  VIEW
  READ
  EDIT
  MANAGE
}

/// Folders organise one owner's documents. They never grant access.
model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner     User       @relation(fields: [ownerId], references: [id])
  documents Document[]

  @@unique([ownerId, name])
  @@map("folders")
}

model Document {
  id               String         @id @default(uuid()) @db.Uuid
  ownerId          String         @map("owner_id") @db.Uuid
  title            String
  description      String?
  category         String
  folderId         String?        @map("folder_id") @db.Uuid
  status           DocumentStatus @default(ACTIVE)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  currentVersionNo Int            @default(1) @map("current_version_no")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner      User              @relation("DocumentOwner", fields: [ownerId], references: [id])
  folder     Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions   DocumentVersion[]
  grants     Grant[]
  breakGlass BreakGlass[]
  approvals  AdminApproval[]
  offlineKeys OfflineKey[]
  downloadApprovals DownloadApproval[]
  accessOverrides   AccessOverride[]

  @@index([ownerId])
  @@index([category])
  @@index([createdAt])
  @@map("documents")
}

/// Metadata of one uploaded file. The encrypted bytes live in document_blobs
/// so listing versions never loads file contents.
model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  versionNo    Int      @map("version_no")
  fileName     String   @map("file_name")
  /// Detected from the file's bytes, never taken from the client.
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  /// SHA-256 of the plaintext, for integrity checks and the audit log.
  sha256       Bytes
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedById], references: [id])
  blob       DocumentBlob?
  quarantine VersionQuarantine?
  downloadApprovals DownloadApproval[]

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

/// AES-256-GCM ciphertext of one version. The data key is random per
/// version and stored only in wrapped (encrypted) form.
model DocumentBlob {
  versionId  String @id @map("version_id") @db.Uuid
  wrappedKey Bytes  @map("wrapped_key")
  keyId      String @map("key_id")
  nonce      Bytes
  authTag    Bytes  @map("auth_tag")
  ciphertext Bytes

  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("document_blobs")
}

/// A stored version the nightly re-scan found infected. Downloads of it are
/// refused. Insert-only for the app (see the migration).
model VersionQuarantine {
  versionId String   @id @map("version_id") @db.Uuid
  signature String
  scanner   String
  foundAt   DateTime @default(now()) @map("found_at") @db.Timestamptz(6)

  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("version_quarantine")
}

/// One permission on one document, for a named user or a group.
model Grant {
  id          String     @id @default(uuid()) @db.Uuid
  documentId  String     @map("document_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  groupId     String?    @map("group_id") @db.Uuid
  level       GrantLevel
  expiresAt   DateTime?  @map("expires_at") @db.Timestamptz(6)
  grantedById String     @map("granted_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Access policy (THREATS.md P1-P12). Downloads need an approval.
  downloadApproval   Boolean  @default(false) @map("download_approval")
  /// A manager the owner nominated to approve downloads (the owner always can).
  downloadApproverId String?  @map("download_approver_id") @db.Uuid
  /// Time window: ISO days (1 Mon .. 7 Sun), local minutes [start, end), IANA zone.
  windowDays         Int[]    @map("window_days") @db.SmallInt
  windowStartMin     Int?     @map("window_start_min") @db.SmallInt
  windowEndMin       Int?     @map("window_end_min") @db.SmallInt
  windowTz           String?  @map("window_tz")
  /// Network allowlist (canonical CIDR strings). Null: any network.
  allowedCidrs       String[] @map("allowed_cidrs")

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User?    @relation("GrantUser", fields: [userId], references: [id])
  downloadApprover User? @relation("GrantDownloadApprover", fields: [downloadApproverId], references: [id], onDelete: SetNull)
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  grantedBy User     @relation("GrantGrantedBy", fields: [grantedById], references: [id])
  /// For a group grant: the members the sharer confirmed (THREATS.md A19).
  coveredMembers GrantGroupMember[]

  @@unique([documentId, userId])
  @@unique([documentId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("grants")
}

/// Who a group grant covers: the group members at the moment the owner (or a
/// manager) shared or confirmed. Written only by tv_confirm_group_members().
model GrantGroupMember {
  grantId     String   @map("grant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  confirmedAt DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)

  grant Grant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([grantId, userId])
  @@index([userId])
  @@map("grant_group_members")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members GroupMember[]
  grants  Grant[]

  @@map("groups")
}

model GroupMember {
  groupId String   @map("group_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// Emergency read access for an admin: written reason, one hour, alerted.
model BreakGlass {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  reason     String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The second admin's approval this window used (required since 20261103310000).
  approvalId String?  @unique @map("approval_id") @db.Uuid

  admin    User     @relation(fields: [adminId], references: [id])
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approval AdminApproval? @relation(fields: [approvalId], references: [id])

  @@index([documentId, adminId])
  @@map("break_glass")
}

/// Signed snapshot of the audit chain head. Append-only like the log.
model AuditCheckpoint {
  seq       BigInt   @id
  headHash  Bytes    @map("head_hash")
  signature Bytes
  keyId     String   @map("key_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_checkpoints")
}

/// WebAuthn credential (passkey) used as a second factor.
model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// A password reset link. Only its SHA-256 is stored; single use, short-lived.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   Bytes     @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  requestedBy String?   @map("requested_by") @db.Uuid
  /// RESET (forgot password), INVITE (new account) or SIGNIN (confirm a sign-in while the account is under attack). Each flow accepts only its own.
  purpose     LinkPurpose @default(RESET)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("ResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A request for an action that needs two administrators (THREATS.md S19).
/// One asks; a different active admin approves or rejects; the one who asked
/// uses it once, for exactly this target, within 24 hours. The database
/// enforces every rule (see the migration). Never deleted.
model AdminApproval {
  id               String         @id @default(uuid()) @db.Uuid
  action           ApprovalAction
  targetUserId     String?        @map("target_user_id") @db.Uuid
  targetDocumentId String?        @map("target_document_id") @db.Uuid
  reason           String
  requestedById    String         @map("requested_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(6)
  approvedById     String?        @map("approved_by") @db.Uuid
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz(6)
  rejectedById     String?        @map("rejected_by") @db.Uuid
  rejectedAt       DateTime?      @map("rejected_at") @db.Timestamptz(6)
  consumedAt       DateTime?      @map("consumed_at") @db.Timestamptz(6)
  expiryRecordedAt DateTime?      @map("expiry_recorded_at") @db.Timestamptz(6)

  targetUser     User?       @relation("ApprovalTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetDocument Document?   @relation(fields: [targetDocumentId], references: [id], onDelete: Cascade)
  requestedBy    User        @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy     User?       @relation("ApprovalApprover", fields: [approvedById], references: [id], onDelete: Cascade)
  rejectedBy     User?       @relation("ApprovalRejecter", fields: [rejectedById], references: [id], onDelete: Cascade)
  breakGlass     BreakGlass?

  @@index([createdAt])
  @@index([targetUserId], map: "admin_approvals_target_user_idx")
  @@map("admin_approvals")
}

/// Instance-wide settings: exactly one row (id = 1). Changed only by an
/// admin, with a fresh second factor, and audited (THREATS.md S21).
model AppSettings {
  id               Int      @id @default(1) @db.SmallInt
  /// Roles that must use a second factor. Always contains ADMIN (a CHECK
  /// constraint enforces it in the database too).
  mfaRequiredRoles Role[]   @default([ADMIN]) @map("mfa_required_roles")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// Who last changed it. Not a foreign key: the audit log is the record.
  updatedById      String?  @map("updated_by_id") @db.Uuid

  @@map("app_settings")
}

/// Key for one person's encrypted copy of a document on the Android app.
/// Wrapped by keyd; deleted when that person drops below READ (THREATS.md V6).
model OfflineKey {
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  wrappedKey Bytes    @map("wrapped_key")
  keyId      String   @map("key_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@map("offline_keys")
}

// ---------------------------------------------------------------------------
// Access policies (migration 20261103600000, THREATS.md P1-P12)
// ---------------------------------------------------------------------------

enum DownloadApprovalStatus {
  PENDING
  APPROVED
  USED
  REJECTED
  EXPIRED
  CANCELLED
}

/// Organisation-wide time window and network rules for one role. Admins only.
model RoleAccessPolicy {
  role           Role     @id
  windowDays     Int[]    @map("window_days") @db.SmallInt
  windowStartMin Int?     @map("window_start_min") @db.SmallInt
  windowEndMin   Int?     @map("window_end_min") @db.SmallInt
  windowTz       String?  @map("window_tz")
  allowedCidrs   String[] @map("allowed_cidrs")
  updatedById    String   @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updatedBy User @relation(fields: [updatedById], references: [id])

  @@map("role_access_policies")
}

/// An owner's emergency exception: lifts one share's conditions for one person, at most 24 hours.
model AccessOverride {
  id          String    @id @default(uuid()) @db.Uuid
  documentId  String    @map("document_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  reason      String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById String?   @map("revoked_by_id") @db.Uuid

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User     @relation("OverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User     @relation("OverrideCreatedBy", fields: [createdById], references: [id])
  revokedBy User?    @relation("OverrideRevokedBy", fields: [revokedById], references: [id])

  @@index([documentId, userId])
  @@map("access_overrides")
}

/// A request to download one version, and its decision. Changed only by
/// tv_decide_download / tv_consume_download / tv_expire_downloads.
model DownloadApproval {
  id           String                 @id @default(uuid()) @db.Uuid
  documentId   String                 @map("document_id") @db.Uuid
  versionId    String                 @map("version_id") @db.Uuid
  requesterId  String                 @map("requester_id") @db.Uuid
  reason       String
  status       DownloadApprovalStatus @default(PENDING)
  decidedById  String?                @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?              @map("decided_at") @db.Timestamptz(6)
  decisionNote String?                @map("decision_note")
  validUntil   DateTime?              @map("valid_until") @db.Timestamptz(6)
  maxUses      Int?                   @map("max_uses")
  uses         Int                    @default(0)
  lastUseTx    BigInt?                @map("last_use_tx")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  document  Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requester User            @relation("DownloadRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User?           @relation("DownloadDecider", fields: [decidedById], references: [id])

  @@index([documentId, createdAt])
  @@index([requesterId, versionId])
  @@map("download_approvals")
}

// ---------------------------------------------------------------------------
// Insider-extraction detection (migration 20261103500000). The service uses
// raw SQL for these tables; the models are here so the schema stays the
// single description of the database. Triggers and column grants are in the
// migration.
// ---------------------------------------------------------------------------

/// One authorised download (or rendered page view), written in the same
/// transaction as its audit event. The database sets occurred_at.
model DownloadFact {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Uuid
  sessionId  String?  @map("session_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  versionNo  Int?     @map("version_no")
  ip         String?
  ipPrefix   String?  @map("ip_prefix")
  kind       String   @default("download")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([userId, occurredAt], map: "download_facts_user_time_idx")
  @@index([sessionId], map: "download_facts_session_idx")
  @@index([ipPrefix, occurredAt], map: "download_facts_prefix_time_idx")
  @@index([occurredAt], map: "download_facts_time_idx")
  @@map("download_facts")
}

/// Admin-tunable detection thresholds and hard download limits.
model RiskSetting {
  key       String   @id
  value     Decimal  @db.Decimal
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("risk_settings")
}

/// A time-boxed, reasoned exception to the hard download limits.
model DownloadLimitOverride {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  dailyLimit   Int       @map("daily_limit")
  sessionLimit Int       @map("session_limit")
  reason       String
  grantedBy    String    @map("granted_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by") @db.Uuid

  @@index([userId, expiresAt], map: "download_limit_overrides_user_idx")
  @@map("download_limit_overrides")
}

/// A persistent alert. Append-only; its review state is SecurityAlertStatus.
model SecurityAlert {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rule          String
  category      String
  severity      String
  severityRank  Int       @default(0) @map("severity_rank") @db.SmallInt
  dedupKey      String    @unique @map("dedup_key")
  subjectUserId String?   @map("subject_user_id") @db.Uuid
  subjectEmail  String?   @map("subject_email")
  documentId    String?   @map("document_id") @db.Uuid
  sessionId     String?   @map("session_id") @db.Uuid
  observed      Decimal?  @db.Decimal
  threshold     Decimal?  @db.Decimal
  windowStart   DateTime? @map("window_start") @db.Timestamptz(6)
  windowEnd     DateTime? @map("window_end") @db.Timestamptz(6)
  message       String
  details       Json?
  auditSeq      BigInt?   @map("audit_seq")

  status SecurityAlertStatus?
  events SecurityAlertEvent[]

  @@index([severityRank(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "security_alerts_rank_time_idx")
  @@index([createdAt(sort: Desc)], map: "security_alerts_time_idx")
  @@index([subjectUserId, createdAt], map: "security_alerts_subject_idx")
  @@index([documentId, createdAt], map: "security_alerts_document_idx")
  @@map("security_alerts")
}

/// Current review state of an alert, derived by trigger from its events.
model SecurityAlertStatus {
  alertId       String   @id @map("alert_id") @db.Uuid
  status        String
  assigneeId    String?  @map("assignee_id") @db.Uuid
  assigneeEmail String?  @map("assignee_email")
  resolution    String?
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  alert SecurityAlert @relation(fields: [alertId], references: [id])

  @@index([status], map: "security_alert_status_status_idx")
  @@map("security_alert_status")
}

/// One review step on an alert (append-only history).
model SecurityAlertEvent {
  id            BigInt   @id @default(autoincrement())
  alertId       String   @map("alert_id") @db.Uuid
  at            DateTime @default(now()) @db.Timestamptz(6)
  action        String
  statusAfter   String   @default("open") @map("status_after")
  actorId       String?  @map("actor_id") @db.Uuid
  actorEmail    String?  @map("actor_email")
  assigneeId    String?  @map("assignee_id") @db.Uuid
  assigneeEmail String?  @map("assignee_email")
  resolution    String?
  note          String?

  alert SecurityAlert @relation(fields: [alertId], references: [id])

  @@index([alertId, id], map: "security_alert_events_alert_idx")
  @@map("security_alert_events")
}

/// How far the alert generator has read the audit log.
model AlertGeneratorState {
  id        Int       @id @db.SmallInt
  lastSeq   BigInt    @map("last_seq")
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastOkAt  DateTime? @map("last_ok_at") @db.Timestamptz(6)
  lastError String?   @map("last_error")

  @@map("alert_generator_state")
}
