[Unit]
Description=TrustVault API
After=network-online.target postgresql.service redis-server.service tvkeyd.service clamav-daemon.service
# Not Requires: if the scanner is down the API keeps serving, and refuses uploads (fails closed).
Wants=network-online.target clamav-daemon.service
Requires=tvkeyd.service

[Service]
Type=simple
User=trustvault
Group=trustvault
WorkingDirectory=/opt/trustvault/app/apps/api
EnvironmentFile=/etc/trustvault/api.env
Environment=KEY_PROVIDER=keyd
Environment=KEYD_SOCKET=/run/tvkeyd/keyd.sock
# Every upload is scanned by ClamAV before it is stored.
Environment=SCANNER=clamd
Environment=CLAMD_SOCKET=/run/clamav/clamd.ctl
# Member of the key service's socket group; keyd also checks our uid.
SupplementaryGroups=tvkeysock
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3

# --- Sandbox: a compromise of the API stays inside this box ---------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Only loopback: Postgres and Redis. keyd and clamd are Unix sockets.
IPAddressDeny=any
IPAddressAllow=localhost
# Nothing on disk is writable except its own log directory.
ReadWritePaths=/var/log/trustvault /run/tvkeyd /run/clamav
InaccessiblePaths=/root /home /etc/trustvault/db.secrets /etc/trustvault/migrate.env /etc/trustvault/seed.passwords /etc/tvkeyd -/var/backups/trustvault
UMask=0077
MemoryMax=768M
TasksMax=256

[Install]
WantedBy=multi-user.target
